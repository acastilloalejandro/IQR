{
  "name": "iqr",
  "version": "0.2.0",
  "private": true,
  "description": "Verifiable QR infrastructure for documents, credentials and contracts.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx cli/iqr.ts",
    "dev:web": "vite --config apps/verifier-web/vite.config.ts",
    "build:web": "vite build --config apps/verifier-web/vite.config.ts",
    "preview:web": "vite preview --config apps/verifier-web/vite.config.ts",
    "dev:analyzer": "vite --config apps/analyzer-web/vite.config.ts",
    "build:analyzer": "vite build --config apps/analyzer-web/vite.config.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
